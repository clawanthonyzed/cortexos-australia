# =============================================================================
# CortexOS — Environment Configuration
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password

# Constructed automatically from POSTGRES_PASSWORD — override only if needed
# DATABASE_URL=postgresql+asyncpg://cortexos:change-me-strong-password@postgres:5432/cortexos

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Auth / Security
# -----------------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-32-char-secret-key-here-must-be-at-least-32-chars

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Default model for agent execution
DEFAULT_LLM_MODEL=claude-sonnet-4-5
DEFAULT_LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Memory — Neo4j (Graphiti)
# -----------------------------------------------------------------------------
NEO4J_PASSWORD=change-me-neo4j-password
GRAPHITI_URI=bolt://neo4j:7687
GRAPHITI_USER=neo4j
GRAPHITI_PASSWORD=change-me-neo4j-password

# -----------------------------------------------------------------------------
# Observability — Langfuse
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://langfuse:3000

# Internal Langfuse service config
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me-langfuse-secret
LANGFUSE_SALT=change-me-langfuse-salt

# -----------------------------------------------------------------------------
# Integrations (optional — leave blank to disable)
# -----------------------------------------------------------------------------
# GitHub — needs: repo, read:org scopes
GITHUB_TOKEN=ghp_...

# Etsy — from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=

# Gumroad — from https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=

# LemonSqueezy — from https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=

# Stripe — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development | production | test
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Email (optional — for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
