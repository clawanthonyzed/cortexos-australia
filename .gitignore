# =============================================================================
# CortexOS .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
# lib/ and lib64/ are Python virtualenv dirs — only ignore at root level
/lib/
/lib64/
wheels/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
pytest.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
pyrightconfig.json

# Linting
.ruff_cache/

# Distribution
*.egg-info
.eggs/

# Node.js
node_modules/
.npm
.node_repl_history
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Build outputs
dist/
build/

# Docker
.docker/
*.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V5
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Secrets & keys
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# Local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Database
*.db
*.sqlite
*.sqlite3

# Backups (store externally, not in git)
backups/
*.sql
*.sql.gz
*.dump

# Traefik ACME certificates (generated at runtime)
traefik/letsencrypt/
traefik/acme.json

# Logs
logs/
*.log
*.log.*

# Temporary files
tmp/
temp/
.tmp/

# Uploads (user-generated content)
uploads/
media/

# Alembic
# (keep versions/ tracked, but not the __pycache__ inside it)
backend/alembic/versions/__pycache__/

# Jupyter
.ipynb_checkpoints
*.ipynb

# macOS
__MACOSX/
