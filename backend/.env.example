# Database
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortexos
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
AGENT_WRITE_TOKEN=change-me-generate-with-python3-c-import-secrets-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Observability
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Memory
MEM0_API_KEY=m0-...

# Knowledge Graph (Neo4j)
GRAPHITI_URI=bolt://localhost:7687
GRAPHITI_USER=neo4j
GRAPHITI_PASSWORD=password

# Commerce
ETSY_API_KEY=
ETSY_SHARED_SECRET=
GUMROAD_ACCESS_TOKEN=
LEMONSQUEEZY_API_KEY=

# GitHub
GITHUB_TOKEN=ghp_...

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://cortexos.au"]

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
